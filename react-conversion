                    const newWidth = window.innerWidth - moveEvent.clientX;
                    if (newWidth > 300 && newWidth < window.innerWidth - 100) { setAiPanelWidth(newWidth); }
                };
                const handleMouseUp = () => { document.removeEventListener('mousemove', handleMouseMove); document.removeEventListener('mouseup', handleMouseUp); document.body.style.cursor = 'default'; };
                document.body.style.cursor = 'col-resize';
                document.addEventListener('mousemove', handleMouseMove);
                document.addEventListener('mouseup', handleMouseUp);
            };

            const renderHighlightedTextOverlay = (text, punchlines) => {
                if (!punchlines || punchlines.length === 0) return <span className="text-slate-200">{text}</span>;
                let elements = [{ text, isPunch: false }];
                punchlines.forEach(punch => {
                    if(!punch || typeof punch !== 'string' || punch.trim() === '') return;
                    const newElements = []; const regex = new RegExp(`(${escapeRegExp(punch)})`, 'gi');
                    elements.forEach(el => {
                        if (el.isPunch) { newElements.push(el); } else {
                            const parts = el.text.split(regex);
                            parts.forEach(part => {
                                if (part.toLowerCase() === punch.toLowerCase()) { newElements.push({ text: part, isPunch: true }); } else if (part) { newElements.push({ text: part, isPunch: false }); }
                            });
                        }
                    });
                    elements = newElements;
                });
                return (
                    <>
                        {elements.map((el, i) => el.isPunch ? <span key={i} className="font-bold underline text-orange-400" style={{ textDecorationColor: '#f97316' }}>{el.text}</span> : <span key={i} className="text-slate-200">{el.text}</span>)}
