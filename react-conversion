                    <div style="background-color:#450a0a; padding:20px; border-radius:8px; border:2px solid #991b1b; white-space:pre-wrap; word-break:break-all;">
                        <strong>Error:</strong> ${event.message}<br/><br/>
                        <strong>Location:</strong> ${event.filename} (Line: ${event.lineno}, Col: ${event.colno})
