                    )}
                    
                    {/* MOBILE BOTTOM NAVIGATION */}
                    <div className="md:hidden fixed bottom-0 left-0 right-0 h-[80px] pb-safe glass-panel border-t border-white/10 flex items-center justify-around px-4 z-[40] shadow-[0_-10px_40px_rgba(0,0,0,0.5)] bg-[#020617]/95 backdrop-blur-xl">
                        <button onClick={() => { setView('workspace'); playSound('pop'); }} className={`flex flex-col items-center gap-1 p-2 transition-all ${view === 'workspace' ? 'text-orange-500' : 'text-slate-500'}`}>
                            <LayoutDashboard size={24} className={view === 'workspace' ? 'fill-orange-500/20' : ''} />
                            <span className="text-[10px] font-black uppercase tracking-widest">Bits</span>
                        </button>
                        
                        <button onClick={() => setIsSetBuilderOpen(true)} className="flex flex-col items-center gap-1 p-2 transition-all text-green-500 -mt-6">
                            <div className="bg-green-600 p-3 rounded-full shadow-[0_0_20px_rgba(34,197,94,0.4)] border-4 border-[#020617] active:scale-90 transition-transform">
                                <Plus size={24} className="text-white" />
                            </div>
                            <span className="text-[10px] font-black uppercase tracking-widest mt-1">Sets</span>
                        </button>
                        
                        <button onClick={() => { setView('dashboard'); playSound('pop'); }} className={`flex flex-col items-center gap-1 p-2 transition-all ${view === 'dashboard' ? 'text-blue-500' : 'text-slate-500'}`}>
                            <Activity size={24} className={view === 'dashboard' ? 'fill-blue-500/20' : ''} />
                            <span className="text-[10px] font-black uppercase tracking-widest">Dash</span>
                        </button>

                        <button onClick={() => { setView('settings'); playSound('pop'); }} className={`flex flex-col items-center gap-1 p-2 transition-all ${view === 'settings' ? 'text-purple-500' : 'text-slate-500'}`}>
                            <Settings size={24} className={view === 'settings' ? 'fill-purple-500/20' : ''} />
                            <span className="text-[10px] font-black uppercase tracking-widest">Config</span>
                        </button>
                    </div>

                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<ErrorBoundary><App /></ErrorBoundary>);
    </script>
</body>
</html>
