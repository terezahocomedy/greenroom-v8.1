                                        <div className="flex-1 w-full">
                                            <label className="text-[10px] text-orange-500 font-black uppercase tracking-[0.2em] flex items-center gap-2 mb-3 md:mb-4"><Lightbulb size={14}/> Highlighted Punchlines</label>
