            // Advanced Tagging State
            const [selectedTags, setSelectedTags] = useState([]);
            const [tagMatchMode, setTagMatchMode] = useState('all'); 
            const [filterLanguage, setFilterLanguage] = useState('');
            const [tagSearchQuery, setTagSearchQuery] = useState('');
            
            // Bulk Action State
            const [selectedBits, setSelectedBits] = useState(new Set());
            
            // Full Screen Views & Modals
            const [isImportModalOpen, setIsImportModalOpen] = useState(false);
            const [isExportModalOpen, setIsExportModalOpen] = useState(false);
            const [isSetBuilderOpen, setIsSetBuilderOpen] = useState(false); 
            const [setBuilderTagFilter, setSetBuilderTagFilter] = useState('');
            const [setBuilderSearch, setSetBuilderSearch] = useState('');
            const [isAutoSetModalOpen, setIsAutoSetModalOpen] = useState(false);
            const [editingPersona, setEditingPersona] = useState(null);
            const [newSetModal, setNewSetModal] = useState({ isOpen: false, name: '' });
            const [showLogModal, setShowLogModal] = useState({ isOpen: false, id: null, setId: '', name: '', date: new Date().toISOString().split('T')[0], language: 'Eng', rating: 0, location: '', notes: '', maxLength: '', videoUrl: '' });
            const [draggedIndex, setDraggedIndex] = useState(null);
            const [setViewMode, setSetViewMode] = useState(window.innerWidth < 768 ? 'list' : 'list');
            const [expandedSetBuilderBits, setExpandedSetBuilderBits] = useState(new Set());
            
            // Dashboard
            const [dashboardTimeframe, setDashboardTimeframe] = useState('6 months');
            const [dashboardDetailView, setDashboardDetailView] = useState(null);
            const [modalSort, setModalSort] = useState({ field: 'date', dir: 'desc' });
            
            // Stage Mode
            const [isStageMode, setIsStageMode] = useState(false);
            const [stageTimer, setStageTimer] = useState(0);
            const [isTimerRunning, setIsTimerRunning] = useState(false);
            const [expandedStageBits, setExpandedStageBits] = useState(new Set());

            useEffect(() => { if (isTimerRunning) { const interval = setInterval(() => { setStageTimer(prev => prev + 1); }, 1000); return () => clearInterval(interval); } }, [isTimerRunning]);
            
            // Initial Load
            useEffect(() => {
                try {
                    const dBits = JSON.parse(localStorage.getItem('gr_bits') || '[]');
                    const dSets = JSON.parse(localStorage.getItem('gr_sets') || '[{"id":"default","name":"Main Club Set","bitIds":[]}]');
                    const dShows = JSON.parse(localStorage.getItem('gr_shows') || '[]');
                    const dPersonas = JSON.parse(localStorage.getItem('gr_personas') || JSON.stringify(DEFAULT_PERSONAS));
                    const dSettings = JSON.parse(localStorage.getItem('gr_settings') || JSON.stringify({ tags: INITIAL_TAGS, activePersonaId: '1', geminiApiKey: '' }));

                    setBits(dBits); setSets(dSets); setActiveSetId(dSets[0]?.id || 'default');
                    setShows(dShows); setPersonas(dPersonas); setTags(dSettings.tags || INITIAL_TAGS);
                    setActivePersonaId(dSettings.activePersonaId || '1');
                    setGeminiApiKey(dSettings.geminiApiKey || '');
                } catch(e) { console.error("Error loading local storage", e); } 
                finally { setIsLoadingData(false); }
            }, []);

            const toggleStageBit = (id) => {
                playSound('click');
                const newSet = new Set(expandedStageBits);
                if (newSet.has(id)) newSet.delete(id); else newSet.add(id);
                setExpandedStageBits(newSet);
            };

            const toggleSetBuilderBit = (id) => {
                playSound('click');
                const newSet = new Set(expandedSetBuilderBits);
                if (newSet.has(id)) newSet.delete(id); else newSet.add(id);
                setExpandedSetBuilderBits(newSet);
            };

            const activeSet = useMemo(() => sets.find(s => s.id === activeSetId) || { id: 'default', name: 'Loading...', bitIds: [] }, [sets, activeSetId]);
            
            const totalSetTime = useMemo(() => {
                return activeSet.bitIds.reduce((acc, id) => {
                    const bit = bits.find(b => b.id === id);
                    return acc + (bit ? parseFloat(bit.duration || 0) : 0);
                }, 0);
            }, [activeSet, bits]);

            const getTabCount = (tab) => {
                if (tab === 'All') return bits.filter(b => b.status !== 'Trashed').length;
                const statusToCheck = tab === 'Trash' ? 'Trashed' : tab;
                return bits.filter(b => b.status === statusToCheck).length;
            };

            const filteredBits = useMemo(() => {
                const getBitSortTime = (b) => {
                    if (b.createdAt) return b.createdAt;
                    const parts = String(b.id).split('_'); const time = parts.length > 1 ? parseInt(parts[0]) : parseInt(b.id);
                    return isNaN(time) ? (b.lastUpdated || 0) : time;
                };

                return bits.filter(b => {
                    if (activeTab === 'Trash') { if (b.status !== 'Trashed') return false; } 
                    else {
                        if (b.status === 'Trashed') return false;
                        if (activeTab !== 'All' && b.status !== activeTab) return false;
                    }

                    const dynamicTags = detectLanguageTags(b.content, b.tags);
                    if (filterLanguage && !dynamicTags.includes(filterLanguage)) return false;

                    if (selectedTags.length > 0) {
                        if (tagMatchMode === 'all') {
                            if (!selectedTags.every(t => dynamicTags.includes(t))) return false;
                        } else {
                            if (!selectedTags.some(t => dynamicTags.includes(t))) return false;
                        }
                    }

                    if (searchQuery.trim()) {
                        const q = searchQuery.toLowerCase();
                        const searchTags = q.match(/#(\w+)/g)?.map(t => t.slice(1)) || [];
                        const textQuery = q.replace(/#\w+/g, '').trim();
                        if (searchTags.length > 0) {
                            const bTagsLower = dynamicTags.map(t => t.toLowerCase());
                            if (!searchTags.every(st => bTagsLower.includes(st))) return false;
                        }

                        if (textQuery) {
                            const matchText = (b.title || "").toLowerCase().includes(textQuery) ||
                                              (b.content || "").toLowerCase().includes(textQuery) ||
                                              (b.tags || []).some(t => t.toLowerCase().includes(textQuery));
                            if (!matchText) return false;
                        }
                    }
                    return true;
                }).sort((a, b) => {
                    if (sortBy === 'name') return (a.title || "").localeCompare(b.title || "");
                    if (sortBy === 'rating') return (b.rating || 0) - (a.rating || 0);
                    if (sortBy === 'oldest') return getBitSortTime(a) - getBitSortTime(b);
                    return getBitSortTime(b) - getBitSortTime(a);
                });
            }, [bits, activeTab, searchQuery, sortBy, selectedTags, tagMatchMode, filterLanguage]);

            const setBuilderBits = useMemo(() => {
                return bits.filter(b => {
                    if (b.status === 'Trashed') return false;

                    if (setBuilderTagFilter) {
                        const dynTags = detectLanguageTags(b.content, b.tags);
                        if (!dynTags.includes(setBuilderTagFilter)) return false;
                    }

                    if (setBuilderSearch.trim()) {
                        const q = setBuilderSearch.toLowerCase();
                        const textMatch = (b.title || "").toLowerCase().includes(q) ||
                                          (b.content || "").toLowerCase().includes(q) ||
                                          (b.tags || []).some(t => t.toLowerCase().includes(q));
                        if (!textMatch) return false;
                    }

                    return true;
                }).sort((a, b) => (b.lastUpdated || 0) - (a.lastUpdated || 0));
            }, [bits, setBuilderTagFilter, setBuilderSearch]);

            const suggestedBits = useMemo(() => {
                if (!activeSet || activeSet.bitIds.length === 0) return [];
                const activeSetTags = new Set();
                activeSet.bitIds.forEach(id => {
                    const b = bits.find(bit => bit.id === id);
                    if (b) {
                        const dyn = detectLanguageTags(b.content, b.tags);
                        dyn.forEach(t => activeSetTags.add(t));
                    }
                });
                return setBuilderBits
                    .filter(b => !activeSet.bitIds.includes(b.id))
                    .map(b => {
                        const dyn = detectLanguageTags(b.content, b.tags);
                        return { ...b, matchScore: dyn.filter(t => activeSetTags.has(t)).length };
                    })
                    .filter(b => b.matchScore > 0)
                    .sort((a, b) => b.matchScore - a.matchScore)
                    .slice(0, 3);
            }, [setBuilderBits, activeSet]);

            const groupedBits = useMemo(() => {
                const groups = {};
                const now = Date.now();
                const sevenDays = 7 * 24 * 60 * 60 * 1000;
                const thirtyDays = 30 * 24 * 60 * 60 * 1000;

                const getBitTime = (b) => {
                    if (b.createdAt) return b.createdAt;
                    const parts = String(b.id).split('_'); const time = parts.length > 1 ? parseInt(parts[0]) : parseInt(b.id);
                    return isNaN(time) ? (b.lastUpdated || 0) : time;
                };

                filteredBits.forEach(bit => {
                    const updated = getBitTime(bit);
                    const diff = now - updated;
                    let groupName = "";

                    if (diff <= sevenDays) groupName = "Previous 7 Days";
                    else if (diff <= thirtyDays) groupName = "Previous 30 Days";
                    else {
                        const d = new Date(updated);
                        groupName = d.toLocaleString('default', { month: 'long', year: 'numeric' });
                    }

                    if (!groups[groupName]) groups[groupName] = [];
                    groups[groupName].push(bit);
                });

                const sortedKeys = Object.keys(groups).sort((a, b) => {
                    const getGroupVal = (g) => g === 'Previous 7 Days' ? now : (g === 'Previous 30 Days' ? now - 7*86400000 : new Date(g).getTime());
                    return sortBy === 'oldest' ? getGroupVal(a) - getGroupVal(b) : getGroupVal(b) - getGroupVal(a);
                });
                const sortedGroups = {};
                sortedKeys.forEach(k => sortedGroups[k] = groups[k]);
                return sortedGroups;
            }, [filteredBits, sortBy]);

            const addBit = () => {
                playSound('pop');
                const newBit = { 
                    id: `${Date.now()}_raw`, title: "New Bit", content: "", notes: "",
                    duration: 0.5, tags: [], punchlines: [], rating: 0, performanceCount: 0,
                    status: "Raw", lastUpdated: Date.now()
                };
                setEditingBitFull(newBit); 
                setActiveTab('All'); 
            };

            const handleTrashBit = (id) => {
                const bit = bits.find(b => b.id === id);
                if (!bit) return;
                if (bit.status === 'Trashed') {
                    playSound('delete');
                    saveBits(bits.filter(b => b.id !== id));
                    saveSets(sets.map(s => {
                        if (s.bitIds.includes(id)) return { ...s, bitIds: s.bitIds.filter(bid => bid !== id) };
                        return s;
                    }));
                } else {
                    playSound('pop');
                    updateBit(id, { status: 'Trashed' });
                }
            };

            const updateBit = (id, updates) => saveBits(bits.map(b => b.id === id ? { ...b, ...updates, lastUpdated: Date.now() } : b));
            
            const updateFullBit = (updatedBit) => {
                const finalBit = { ...updatedBit, lastUpdated: Date.now() };
                if (bits.some(b => b.id === finalBit.id)) saveBits(bits.map(b => b.id === finalBit.id ? finalBit : b));
                else saveBits([finalBit, ...bits]);
                playSound('success');
            };

            const handleAddTag = (newTag) => {
                const cleanTag = newTag.replace(/^#/, '').trim();
                if (cleanTag && !tags.includes(cleanTag)) {
                    saveSettings({ tags: [...tags, cleanTag], activePersonaId });
                }
            };

            const handleDeleteTag = (tagToDelete) => {
                if(window.confirm(`Permanently delete tag "${tagToDelete}"?`)){
                    playSound('delete');
                    const newTags = tags.filter(t => t !== tagToDelete);
                    saveSettings({ tags: newTags, activePersonaId });
                    setSelectedTags(prev => prev.filter(t => t !== tagToDelete));
                    const updatedBits = bits.map(b => {
                        if (b.tags && b.tags.includes(tagToDelete)) {
                            return { ...b, tags: b.tags.filter(t => t !== tagToDelete), lastUpdated: Date.now() };
                        }
                        return b;
                    });
                    saveBits(updatedBits);
                }
            };

            const handleSidebarTagClick = (t) => {
                playSound('click');
                if (editingBitFull) {
                    const isActive = editingBitFull.tags.includes(t);
                    const newTags = isActive ? editingBitFull.tags.filter(x => x !== t) : [...editingBitFull.tags, t];
                    setEditingBitFull({ ...editingBitFull, tags: newTags });
                } else {
                    const isActive = selectedTags.includes(t);
                    setSelectedTags(prev => isActive ? prev.filter(x => x !== t) : [...prev, t]);
                }
            };

            const confirmAddSet = () => {
                if (newSetModal.name.trim()) {
                    playSound('pop');
                    const newSet = { id: Date.now().toString(), name: newSetModal.name.trim(), bitIds: [] };
                    saveSets([...sets, newSet]);
                    setActiveSetId(newSet.id);
                }
                setNewSetModal({ isOpen: false, name: '' });
            };

            const removeSet = (id) => {
                if (sets.length <= 1) return;
                playSound('delete');
                saveSets(sets.filter(s => s.id !== id));
                if (activeSetId === id) {
                    const remaining = sets.filter(s => s.id !== id);
                    if(remaining.length > 0) setActiveSetId(remaining[0].id);
                }
            };

            const cloneSet = () => {
                if (!activeSet) return;
                playSound('magic');
                const newSet = { id: Date.now().toString(), name: activeSet.name + " (Copy)", bitIds: [...activeSet.bitIds] };
                saveSets([...sets, newSet]);
                setActiveSetId(newSet.id);
            };

            const handleSetNameChange = (e) => saveSets(sets.map(s => s.id === activeSetId ? {...s, name: e.target.value} : s));
            
            const addBitToSet = (bitId) => {
                if (!activeSet.bitIds.includes(bitId)) {
                    playSound('pop');
                    saveSets(sets.map(s => s.id === activeSetId ? { ...s, bitIds: [...activeSet.bitIds, bitId] } : s));
                }
            };

            const removeBitFromSet = (indexToRemove) => {
                playSound('pop');
                const newBitIds = [...activeSet.bitIds];
                newBitIds.splice(indexToRemove, 1);
                saveSets(sets.map(s => s.id === activeSetId ? { ...s, bitIds: newBitIds } : s));
            };

            // MOBILE FRIENDLY: Move Bit Up/Down in the set list without dragging
            const moveBitInSet = (index, direction) => {
                playSound('pop');
                const newBitIds = [...activeSet.bitIds];
                if (direction === 'up' && index > 0) {
                    [newBitIds[index - 1], newBitIds[index]] = [newBitIds[index], newBitIds[index - 1]];
                } else if (direction === 'down' && index < newBitIds.length - 1) {
                    [newBitIds[index + 1], newBitIds[index]] = [newBitIds[index], newBitIds[index + 1]];
                }
                saveSets(sets.map(s => s.id === activeSetId ? { ...s, bitIds: newBitIds } : s));
            };

            const handleDragOver = (e, index) => {
                e.preventDefault();
                if (draggedIndex === null || draggedIndex === index) return;
                playSound('pop');
                const newBitIds = [...activeSet.bitIds];
                const draggedItem = newBitIds[draggedIndex];
                newBitIds.splice(draggedIndex, 1);
                newBitIds.splice(index, 0, draggedItem);
                saveSets(sets.map(s => s.id === activeSetId ? { ...s, bitIds: newBitIds } : s));
                setDraggedIndex(index);
            };

            // Bulk Actions
            const toggleBitSelection = (e, id) => {
                e.stopPropagation();
                const newSet = new Set(selectedBits);
                if (newSet.has(id)) newSet.delete(id);
                else newSet.add(id);
                setSelectedBits(newSet);
            };

            const handleBulkStatusChange = (status) => {
                playSound('magic');
                const newBits = bits.map(b => selectedBits.has(b.id) ? { ...b, status, lastUpdated: Date.now() } : b);
                saveBits(newBits);
                setSelectedBits(new Set());
            };

            const handleBulkAddTag = (tag) => {
                playSound('success');
                const cleanTag = tag.replace(/^#/, '').trim();
                if(!cleanTag) return;
                
                if (!tags.includes(cleanTag)) {
                    saveSettings({ tags: [...tags, cleanTag], activePersonaId });
                }
                
                const newBits = bits.map(b => {
                    if (selectedBits.has(b.id) && !(b.tags || []).includes(cleanTag)) {
                        return { ...b, tags: [...(b.tags||[]), cleanTag], lastUpdated: Date.now() };
                    }
                    return b;
                });
                saveBits(newBits);
                setSelectedBits(new Set());
            };

            const handleBulkTrash = () => {
                if(window.confirm(`Move ${selectedBits.size} bits to trash?`)){
                    playSound('delete');
                    const newBits = bits.map(b => selectedBits.has(b.id) ? { ...b, status: 'Trashed', lastUpdated: Date.now() } : b);
                    saveBits(newBits);
                    setSelectedBits(new Set());
                }
            };

            const confirmLogShow = () => {
                playSound('success');
                const showData = {
                    id: showLogModal.id || Date.now().toString(), name: showLogModal.name || 'Untitled Show',
                    date: new Date(showLogModal.date).getTime(), language: showLogModal.language, rating: showLogModal.rating,
                    location: showLogModal.location, setId: showLogModal.setId, notes: showLogModal.notes,
                    maxLength: showLogModal.maxLength, videoUrl: showLogModal.videoUrl
                };
                if (shows.some(s => s.id === showData.id)) saveShows(shows.map(s => s.id === showData.id ? showData : s));
                else saveShows([...shows, showData]);
                
                if (showLogModal.setId) {
                    const performedSet = sets.find(s => s.id === showLogModal.setId);
                    if (performedSet) {
                        const updatedBits = bits.map(b => {
                            if (performedSet.bitIds.includes(b.id)) return { ...b, performanceCount: (b.performanceCount || 0) + 1, lastUpdated: Date.now() };
                            return b;
                        });
                        saveBits(updatedBits);
                    }
                }
                setShowLogModal({ isOpen: false, id: null, setId: '', name: '', date: '', language: 'Eng', rating: 0, location: '', notes: '', maxLength: '', videoUrl: '' });
            };

            const handleDeleteShow = (e, show) => {
                e.stopPropagation();
                if (window.confirm("Delete this logged show?")) {
                    playSound('delete');
                    saveShows(shows.filter(s => s.id !== show.id));
                    if (show.setId) {
                        const performedSet = sets.find(s => s.id === show.setId);
                        if (performedSet) {
                            const updatedBits = bits.map(b => {
                                if (performedSet.bitIds.includes(b.id)) return { ...b, performanceCount: Math.max(0, (b.performanceCount || 0) - 1), lastUpdated: Date.now() };
                                return b;
                            });
                            saveBits(updatedBits);
                        }
                    }
                }
            };

            const saveEditingPersona = (updatedPersona) => {
                const pToSave = updatedPersona || editingPersona;
                if (!pToSave || !pToSave.name.trim()) return;
                playSound('success');
                const idToSave = pToSave.id || Date.now().toString();
                const newPersona = { ...pToSave, id: idToSave };
                if (personas.some(p => p.id === idToSave)) savePersonas(personas.map(p => p.id === idToSave ? newPersona : p));
                else savePersonas([...personas, newPersona]);
                setEditingPersona(null);
            };
            
            const deletePersona = (idToDelete) => {
                if(personas.length > 1 && window.confirm('Delete Persona?')) {
                    playSound('delete');
                    const newPersonas = personas.filter(per => per.id !== idToDelete);
                    savePersonas(newPersonas);
                    if (activePersonaId === idToDelete && newPersonas.length > 0) saveSettings({ tags, activePersonaId: newPersonas[0].id });
                }
            };

            const renderStars = (rating) => {
                if (!rating || rating === 0) return null;
                return <span className="text-orange-500 text-[10px] md:text-xs ml-2 tracking-widest">{'★'.repeat(rating)}</span>;
            };

            const displayPersonas = useMemo(() => {
                const sortedPersonas = [...personas].sort((a, b) => {
                    if (personaSort === 'name-asc') {
                        return (a.name || "").localeCompare(b.name || "");
                    }
                    return 0; 
                });
                return sortedPersonas;
            }, [personas, personaSort]);

            const getDashboardData = () => {
                const now = new Date();
                let since = 0, monthsInRange = 1;
                const targetDate = new Date(now);
                if (dashboardTimeframe === '1 month') { targetDate.setMonth(now.getMonth() - 1); since = targetDate.getTime(); monthsInRange = 1; }
                else if (dashboardTimeframe === '3 months') { targetDate.setMonth(now.getMonth() - 3); since = targetDate.getTime(); monthsInRange = 3; }
                else if (dashboardTimeframe === '6 months') { targetDate.setMonth(now.getMonth() - 6); since = targetDate.getTime(); monthsInRange = 6; }
                else if (dashboardTimeframe === '1 year') { targetDate.setFullYear(now.getFullYear() - 1); since = targetDate.getTime(); monthsInRange = 12; }
                else {
                    since = 0;
                    if (shows.length > 0) {
                        const firstShowDate = Math.min(...shows.map(s => s.date));
                        monthsInRange = Math.max(1, (now.getTime() - firstShowDate) / (1000 * 60 * 60 * 24 * 30.44));
                    }
                }

                const getCreationTime = (b) => {
                    if (b.createdAt) return b.createdAt;
                    const parts = String(b.id).split('_');
                    if (parts.length > 1) return parseInt(parts[1]) || b.lastUpdated;
                    return parseInt(b.id) || b.lastUpdated;
                };

                const periodShows = shows.filter(s => s.date >= since);
                const languageStats = periodShows.reduce((acc, s) => {
                    let lang = s.language || 'Eng';
                    if (lang === 'English') lang = 'Eng'; 
                    if (lang === '中文' || lang === 'Canton') lang = '廣東話'; 
                    acc[lang] = (acc[lang] || 0) + 1;
                    return acc;
                }, {});

                const totalReadyMinutes = bits.filter(b => b.status === 'Ready').reduce((acc, b) => acc + (b.duration || 0), 0);
                const totalStageTime = periodShows.reduce((acc, s) => acc + (parseFloat(s.maxLength) || 0), 0);

                const pipeline = {
                    raw: bits.filter(b => b.status === 'Raw' && b.status !== 'Trashed').length,
                    inProgress: bits.filter(b => b.status === 'In Progress' && b.status !== 'Trashed').length,
                    ready: bits.filter(b => b.status === 'Ready' && b.status !== 'Trashed').length,
                };

                return {
                    newBits: bits.filter(b => getCreationTime(b) >= since && b.status !== 'Trashed'),
                    shows: periodShows, readyBits: bits.filter(b => b.status === 'Ready' && getCreationTime(b) >= since),
                    totalSets: sets, averageShows: (periodShows.length / Math.ceil(monthsInRange)).toFixed(1),
                    languageStats, totalReadyMinutes, totalStageTime, pipeline
                };
            };
            
            const dashboardData = getDashboardData();
            
            const formatStageTime = (totalMinutes) => {
                const h = Math.floor(totalMinutes / 60);
                const m = Math.round(totalMinutes % 60);
                if (h > 0) return `${h}h ${m}m`; return `${m}m`;
            };

            const chartData = useMemo(() => {
                const months = []; const now = new Date();
                let numBars = dashboardTimeframe === '1 month' ? 1 : dashboardTimeframe === '3 months' ? 3 : dashboardTimeframe === '6 months' ? 6 : 12;
                for (let i = numBars - 1; i >= 0; i--) {
                    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                    months.push({ label: d.toLocaleString('default', { month: 'short' }) + (numBars > 6 ? ` '${d.getFullYear().toString().slice(2)}` : ''), year: d.getFullYear(), month: d.getMonth(), shows: 0, bits: 0 });
                }
                
                shows.forEach(s => {
                    const d = new Date(s.date); const m = months.find(x => x.year === d.getFullYear() && x.month === d.getMonth());
                    if (m) m.shows++;
                });
                
                bits.forEach(b => {
                    if(b.status === 'Trashed') return;
                    let creationTime = b.createdAt;
                    if (!creationTime) {
                        const parts = String(b.id).split('_');
                        creationTime = parts.length > 1 ? parseInt(parts[1]) : (parseInt(b.id) || b.lastUpdated);
                    }
                    if (!isNaN(creationTime)) {
                        const d = new Date(creationTime);
                        const m = months.find(x => x.year === d.getFullYear() && x.month === d.getMonth());
                        if (m) m.bits++;
                    }
                });
                return { months, maxVal: Math.max(...months.map(m => Math.max(m.shows, m.bits)), 1), numBars };
            }, [shows, bits, dashboardTimeframe]);

            const sortedModalData = useMemo(() => {
                if (!dashboardDetailView) return [];
                return [...(dashboardData[dashboardDetailView] || [])].sort((a, b) => {
                    if (modalSort.field === 'rating') return modalSort.dir === 'desc' ? (b.rating || 0) - (a.rating || 0) : (a.rating || 0) - (b.rating || 0);
                    const tA = a.date || a.lastUpdated || 0; const tB = b.date || b.lastUpdated || 0;
                    return modalSort.dir === 'desc' ? tB - tA : tA - tB;
                });
