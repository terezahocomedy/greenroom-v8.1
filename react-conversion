    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo, useRef, Component } = React;
        const L = window.lucideReact || window.LucideReact || {};
        const IconProxy = new Proxy(L, {
            get: function(target, prop) {
                if (prop in target && target[prop] !== undefined) return target[prop];
                return (props) => <span {...props} style={{display:'inline-block', width:'1em', height:'1em', backgroundColor:'currentColor', opacity: 0.1, borderRadius:'2px'}}/>;
            }
        });

        const { 
            Mic2, LayoutDashboard, Settings, Plus, Save, Trash2, Download, Upload, ChevronDown, ChevronUp, Link2, 
            Star, MessageSquare, Play, Video, Target, Wand2, GripVertical, Copy, X, Check, AlertCircle, Clock,
            Search, Filter, Type, Calendar, ArrowUp, ArrowDown, Maximize2, Square, Circle, Sparkles, Activity, Database,
            FileText, UserCircle, Edit3, BarChart, Globe, CheckCircle, Zap, Lightbulb, Link, Undo, Redo, ExternalLink, 
            Highlighter, Eraser, LayoutList, LayoutGrid, Send, RotateCcw, ChevronRight, Folder, Hash, Volume2, CheckSquare,
            PanelRightClose, PanelRightOpen, ChevronLeft
        } = IconProxy;

        class ErrorBoundary extends Component {
            constructor(props) { super(props); this.state = { hasError: false, error: null, errorInfo: null }; }
            static getDerivedStateFromError(error) { return { hasError: true }; }
            componentDidCatch(error, errorInfo) { this.setState({ error, errorInfo }); console.error("React Error Boundary caught an error:", error, errorInfo); }
            render() {
                if (this.state.hasError) {
                    return (
                        <div className="min-h-screen bg-red-950 text-red-200 p-8 font-mono flex flex-col items-center justify-center pt-safe pb-safe">
                            <div className="w-full max-w-4xl bg-red-900 border border-red-500/50 p-8 rounded-2xl shadow-2xl glass-panel">
                                <h1 className="text-4xl font-black text-white mb-2 flex items-center gap-4"><AlertCircle size={40} /> REACT CRASH CATCHER</h1>
                                <p className="text-xl mb-6 text-red-300">Something broke inside a component. Here is the exact error:</p>
                                <div className="bg-black/40 p-6 rounded-xl border border-red-800/50 overflow-auto mb-6">
                                    <h2 className="text-white font-bold mb-2">Error Message:</h2>
                                    <code className="text-sm whitespace-pre-wrap text-red-400">{this.state.error && this.state.error.toString()}</code>
                                </div>
                            </div>
                        </div>
                    );
                }
                return this.props.children;
            }
        }
        
        const INITIAL_TAGS = ["Opener", "Closer", "Crowd Work", "Callback", "18+", "Corporate", "English", "中文", "Canton", "Eng", "廣東話", "普通話"];
        const DEFAULT_PERSONAS = [
            { id: '1', name: 'Comedy Consultant', prompt: 'You are a bilingual stand-up comedy consultant specializing in observational humor. Review my joke and make the punchline hit harder. Keep the language (English/Cantonese) consistent with the input.' },
            { id: '2', name: 'Roast Master', prompt: 'You are a savage roast comic. Review this bit and make it sharper, more aggressive, and add a killer tag at the end.' }
        ];

        const calculateDuration = (text) => {
            if (!text) return 0;
            const words = text.trim().split(/\s+/).filter(Boolean).length;
            return Math.round((words / 110) * 10) / 10;
        };

        const fetchWithRetry = async (url, options, retries = 3) => {
            const delays = [1000, 2000, 4000];
            for (let i = 0; i < retries; i++) {
                try {
                    const response = await fetch(url, options);
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    return await response.json();
                } catch (error) {
                    if (i === retries - 1) throw new Error("API request failed: " + error.message);
                    await new Promise(res => setTimeout(res, delays[i]));
                }
            }
        };

        const detectLanguageTags = (text, existingTags = []) => {
            const tags = new Set(existingTags);
            if (!text) return Array.from(tags);
            const hasChinese = /[\u4e00-\u9fa5]/.test(text);
            if (hasChinese) {
                tags.add("中文");
                tags.add("Canton");
            } else if (/[a-zA-Z]/.test(text)) {
                tags.add("English");
            }
            return Array.from(tags);
        };

        const escapeRegExp = (string) => string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

        const pcmToWav = (base64Pcm, sampleRate) => {
            const pcmData = Uint8Array.from(atob(base64Pcm), c => c.charCodeAt(0));
            const numChannels = 1; const bitsPerSample = 16; const byteRate = sampleRate * numChannels * (bitsPerSample / 8);
            const blockAlign = numChannels * (bitsPerSample / 8); const wavSize = 44 + pcmData.length;
            const buffer = new ArrayBuffer(wavSize);
            const view = new DataView(buffer);
            const writeString = (view, offset, string) => { for (let i = 0; i < string.length; i++) { view.setUint8(offset + i, string.charCodeAt(i)); } };
            writeString(view, 0, 'RIFF'); view.setUint32(4, 36 + pcmData.length, true);
            writeString(view, 8, 'WAVE'); writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true); view.setUint16(22, numChannels, true);
            view.setUint32(24, sampleRate, true); view.setUint32(28, byteRate, true);
            view.setUint16(32, blockAlign, true); view.setUint16(34, bitsPerSample, true);
            writeString(view, 36, 'data'); view.setUint32(40, pcmData.length, true);
            const pcmView = new Uint8Array(buffer, 44); pcmView.set(pcmData);
            return new Blob([view], { type: 'audio/wav' });
        };

        let audioCtx = null;
        const playSound = (type) => {
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const playOsc = (freq, waveType, startTime, duration, slideTo = null, vol = 0.05) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = waveType; osc.frequency.setValueAtTime(freq, audioCtx.currentTime + startTime);
                    if (slideTo) osc.frequency.exponentialRampToValueAtTime(slideTo, audioCtx.currentTime + startTime + duration);
                    gain.gain.setValueAtTime(0, audioCtx.currentTime + startTime);
                    gain.gain.linearRampToValueAtTime(vol, audioCtx.currentTime + startTime + (duration * 0.1));
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + startTime + duration);
                    osc.connect(gain); gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + startTime); osc.stop(audioCtx.currentTime + startTime + duration);
                };
                switch(type) {
                    case 'pop': playOsc(400, 'sine', 0, 0.15, 300, 0.06); break;
                    case 'click': playOsc(1200, 'sine', 0, 0.04, 1000, 0.1); break;
                    case 'success': playOsc(523.25, 'sine', 0, 0.4, null, 0.04); playOsc(659.25, 'sine', 0.08, 0.4, null, 0.04); playOsc(783.99, 'sine', 0.16, 0.6, null, 0.04); break;
                    case 'delete': playOsc(150, 'sine', 0, 0.25, 80, 0.08); break;
                    case 'magic': playOsc(600, 'sine', 0, 0.5, 1200, 0.03); playOsc(800, 'sine', 0.1, 0.5, 1600, 0.02); break;
                    case 'stage': playOsc(440, 'triangle', 0, 1.2, null, 0.06); playOsc(443, 'triangle', 0, 1.2, null, 0.04); break;
                    case 'timer': playOsc(400, 'sine', 0, 0.05, null, 0.03); break;
                }
            } catch (e) {}
        };

        const formatTimer = (totalSeconds) => { const s = Math.floor(totalSeconds % 60).toString().padStart(2, '0'); const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0'); return `${m}:${s}`; };

        const formatDateTime = (timestamp) => {
            const d = new Date(timestamp);
            if (isNaN(d.getTime())) return "";
            return d.getFullYear() + '-' +
                   String(d.getMonth() + 1).padStart(2, '0') + '-' +
                   String(d.getDate()).padStart(2, '0') + ' ' +
                   String(d.getHours()).padStart(2, '0') + ':' +
                   String(d.getMinutes()).padStart(2, '0');
        };

        function PersonaEditor({ persona, onClose, onSave, onDelete, personas, playSound }) {
            const [localPersona, setLocalPersona] = useState(persona || { id: null, name: '', prompt: '' });
            const handleSave = () => { onSave(localPersona); playSound('success'); };
            
            return (
                <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center z-[110] p-4 font-sans pb-safe">
                    <div className="glass-panel rounded-3xl w-full max-w-2xl p-6 md:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.6)] animate-in zoom-in-95 flex flex-col">
                        <div className="flex justify-between items-center border-b border-white/10 pb-6 mb-8">
                            <h2 className="text-xl md:text-2xl font-black text-purple-400 flex items-center gap-3 uppercase tracking-widest"><UserCircle className="text-purple-500"/> {persona && persona.id ? 'Edit Persona' : 'New Persona'}</h2>
                            <button onClick={onClose} className="text-slate-400 hover:text-white bg-black/40 p-2.5 rounded-xl border border-white/10 transition-all btn-press" title="Close"><X size={20}/></button>
                        </div>
                        <div className="space-y-6">
                            <div>
                                <label className="text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-3 block">Persona Name</label>
                                <input
                                    className="w-full glass-input p-4 rounded-xl text-slate-100 text-base font-black focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all"
                                    value={localPersona.name}
                                    onChange={e => setLocalPersona({ ...localPersona, name: e.target.value })}
                                    placeholder="e.g. Roast Master"
                                />
                            </div>
                            <div>
                                <label className="text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-3 block">AI System Prompt (Role/Instructions)</label>
                                <textarea
                                    className="w-full glass-input p-5 rounded-xl text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all resize-none h-32 md:h-48 custom-scrollbar leading-relaxed font-sans"
                                    value={localPersona.prompt}
                                    onChange={e => setLocalPersona({ ...localPersona, prompt: e.target.value })}
                                    placeholder="You are a stand-up comedy consultant specializing in observational humor..."
                                />
                            </div>
                        </div>
                        <div className="flex justify-between items-center pt-8 border-t border-white/10 mt-8">
                            <button onClick={() => { onDelete(localPersona.id); onClose(); }} disabled={personas.length <= 1 || (persona && (persona.id === '1' || persona.id === '2'))} className="text-red-400 hover:text-red-300 px-4 md:px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-widest transition-all disabled:opacity-50 border border-red-500/30 hover:bg-red-500/10" title="Delete Persona">
                                <Trash2 size={16} className="inline md:mr-2" /> <span className="hidden md:inline">Trash</span>
                            </button>
                            <div className="flex gap-2 md:gap-4">
                                <button onClick={onClose} className="px-4 md:px-6 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 font-black text-xs uppercase tracking-widest transition-all btn-press">Cancel</button>
                                <button onClick={handleSave} disabled={!localPersona.name.trim() || !localPersona.prompt.trim()} className="bg-purple-600/90 hover:bg-purple-500 text-white px-4 md:px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest transition-all border border-purple-500/50 shadow-[0_4px_15px_rgba(168,85,247,0.4)] btn-press flex items-center gap-2">
                                    <Save size={16}/> <span className="hidden md:inline">Save Persona</span><span className="md:hidden">Save</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // --- SUB-COMPONENTS ---
        
        function InlineBitEditor({ bit, onChange, allTags, personas, defaultPersonaId, geminiApiKey, onClose, onSave, onTrash, onAddToSet, onAddTag, onDuplicate, onNewBit, playSound }) {
            const contentRef = useRef(null);
            const overlayRef = useRef(null);
            const chatEndRef = useRef(null);
            const audioRef = useRef(null);
            
            const [history, setHistory] = useState([bit.content || '']);
            const [historyIndex, setHistoryIndex] = useState(0);
            const [showHighlights, setShowHighlights] = useState(false);

            const [showAI, setShowAI] = useState(false);
            const [localPersonaId, setLocalPersonaId] = useState(defaultPersonaId);
            const [isAILoading, setIsAILoading] = useState(false);
            const [aiChat, setAiChat] = useState([]); 
            const [aiDraft, setAiDraft] = useState('');
            const [chatInput, setChatInput] = useState('');
            const [isTTSLoading, setIsTTSLoading] = useState(false);
            
            const getCreationDate = (b) => {
                if (b.createdAt) return b.createdAt;
                const parts = String(b.id).split('_'); const time = parts.length > 1 ? parseInt(parts[0]) : parseInt(b.id);
                return isNaN(time) ? Date.now() : time;
            };

            const [dateInput, setDateInput] = useState(() => formatDateTime(getCreationDate(bit)));

            useEffect(() => {
                setDateInput(formatDateTime(getCreationDate(bit)));
            }, [bit.id, bit.createdAt]);

            const handleDateBlur = () => {
                let parsedTime = new Date(dateInput).getTime();
                if (/^\d{4}$/.test(dateInput.trim())) {
                    parsedTime = new Date(`${dateInput.trim()}-01-01T12:00:00`).getTime();
                }
                if (!isNaN(parsedTime)) {
                    onChange({ ...bit, createdAt: parsedTime });
                    setDateInput(formatDateTime(parsedTime));
                } else {
                    setDateInput(formatDateTime(getCreationDate(bit)));
                }
            };

            const handleCopyDraft = () => {
                playSound('pop');
                navigator.clipboard.writeText(aiDraft).catch(err => {
                    const textArea = document.createElement("textarea"); textArea.value = aiDraft; document.body.appendChild(textArea); textArea.focus(); textArea.select();
                    try { document.execCommand('copy'); } catch (err) {} document.body.removeChild(textArea);
                });
            };

            const [isPlayingTTS, setIsPlayingTTS] = useState(false);
            const [aiPanelWidth, setAiPanelWidth] = useState(window.innerWidth < 768 ? window.innerWidth : 480);

            const [editorTagInput, setEditorTagInput] = useState('');
            const [showTagDropdown, setShowTagDropdown] = useState(false);

            useEffect(() => { chatEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [aiChat, isAILoading]);
            useEffect(() => { return () => { if (audioRef.current) { audioRef.current.pause(); audioRef.current.src = ""; } }; }, []);

            const handleContentChange = (e) => {
                const val = e.target.value;
                const newDuration = calculateDuration(val);
                const newTags = detectLanguageTags(val, bit.tags);
                newTags.forEach(t => { if (!allTags.includes(t)) onAddTag(t); });
                onChange({ ...bit, content: val, duration: newDuration, tags: newTags });
            };

            const pushHistory = () => {
                if (history[historyIndex] !== bit.content) {
                    const newHistory = history.slice(0, historyIndex + 1);
                    newHistory.push(bit.content);
                    setHistory(newHistory); setHistoryIndex(newHistory.length - 1);
                }
            };

            const undo = () => { if (historyIndex > 0) { setHistoryIndex(historyIndex - 1); onChange({...bit, content: history[historyIndex - 1]}); } };
            const redo = () => { if (historyIndex < history.length - 1) { setHistoryIndex(historyIndex + 1); onChange({...bit, content: history[historyIndex + 1]}); } };

            const handleTagInputChange = (e) => {
                const val = e.target.value;
                setEditorTagInput(val);
                if (val.trim().length > 0) setShowTagDropdown(true); else setShowTagDropdown(false);
            };

            const commitEditorTag = (tagToCommit) => {
                const cleanTag = tagToCommit.replace(/^#/, '').trim();
                if (!cleanTag) return;
                if (!bit.tags.includes(cleanTag)) { onChange({...bit, tags: [...bit.tags, cleanTag]}); }
                if (!allTags.includes(cleanTag)) { onAddTag(cleanTag); }
                setEditorTagInput(''); setShowTagDropdown(false); playSound('pop');
            };

            const addSpecificPunchline = (text) => {
                if (text && !bit.punchlines.includes(text)) { onChange({ ...bit, punchlines: [...bit.punchlines, text] }); playSound('pop'); }
            };

            const handleHighlightSelection = () => {
                const textarea = contentRef.current;
                if (!textarea) return;
                const start = textarea.selectionStart; const end = textarea.selectionEnd;
                if (start !== end) {
                    const selectedText = bit.content.substring(start, end).trim();
                    if (selectedText) { addSpecificPunchline(selectedText); textarea.focus(); textarea.setSelectionRange(start, end); }
                }
            };

            const handleTTS = async () => {
                if (isPlayingTTS) { audioRef.current?.pause(); setIsPlayingTTS(false); return; }
                if (!bit.content) return;
                setIsTTSLoading(true);
                try {
                    const apiKey = geminiApiKey || "";
                    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
                    const prompt = `Read this comedy bit in a storyteller voice: ${bit.content}`;
                    const payload = { 
                        contents: [{ parts: [{ text: prompt }] }], 
                        generationConfig: { responseModalities: ["AUDIO"], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } } } },
                        model: "gemini-2.5-flash-preview-tts" 
                    };
                    const res = await fetchWithRetry(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    const inlineData = res.candidates?.[0]?.content?.parts?.[0]?.inlineData;
                    if (!inlineData) throw new Error("No audio generated.");
                    const mimeType = inlineData.mimeType || "audio/L16; rate=24000";
                    const sampleRateMatch = mimeType.match(/rate=(\d+)/);
                    const sampleRate = sampleRateMatch ? parseInt(sampleRateMatch[1]) : 24000;
                    const wavBlob = pcmToWav(inlineData.data, sampleRate);
                    const audioUrl = URL.createObjectURL(wavBlob);
                    if (audioRef.current) { audioRef.current.src = audioUrl; audioRef.current.play(); setIsPlayingTTS(true); audioRef.current.onended = () => setIsPlayingTTS(false); }
                } catch (err) { 
                    console.error("TTS Error:", err);
                    if (err.message.includes('429')) {
                        alert("TTS failed: Rate limit exceeded (429). The free Gemini API allows 15 requests per minute. Please wait a moment before playing audio again.");
                    } else if (err.message.includes('503')) {
                        alert("TTS failed: Google API Server Overloaded (503). This is normal for preview models. Wait a few seconds and try again.");
                    } else {
                        alert("TTS failed: " + err.message);
                    }
                } finally { setIsTTSLoading(false); }
            };

            const handleDuplicate = () => {
                playSound('magic');
                const clone = { ...bit, id: `${Date.now()}_clone`, title: bit.title + " (Copy)", lastUpdated: Date.now(), performanceCount: 0, rating: 0 };
                onDuplicate(clone);
            };

            const sendAiMessage = async (isInitial = false) => {
                setShowAI(true);
                if(!isInitial && !chatInput.trim()) return;
                const currentInput = chatInput.trim();
                if(!isInitial) { setAiChat(prev => [...prev, { role: 'user', text: currentInput }]); setChatInput(''); }
                setIsAILoading(true);
                const apiKey = geminiApiKey || "";
                const modelName = apiKey ? "gemini-3.5-flash" : "gemini-2.5-flash-preview-09-2025";
                const activePersona = personas.find(p => p.id === localPersonaId) || personas[0];
                try {
                    const url = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;
                    const prompt = isInitial 
                        ? `${activePersona.prompt}\n\nReview this bit:\nTitle: ${bit.title}\nContent: ${bit.content}\nRespond strictly with JSON: {"rewrittenContent":"...", "notes":"..."}`
                        : `${activePersona.prompt}\n\nOriginal: "${bit.content}"\nUser feedback: "${currentInput}"\nRespond strictly with JSON: {"rewrittenContent":"...", "notes":"..."}`;
                    const payload = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: "application/json" }, model: modelName };
                    const response = await fetchWithRetry(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    const data = response.candidates[0].content.parts[0].text;
                    let parsedData; try { parsedData = JSON.parse(data); } catch (e) { parsedData = JSON.parse(data.replace(/```json/gi, '').replace(/```/g, '').trim()); }
                    const generatedDraft = parsedData.rewrittenContent || bit.content;
                    setAiDraft(generatedDraft);
                    setAiChat(prev => [...prev, { role: 'ai', text: parsedData.notes || "Draft revised.", draft: generatedDraft }]);
                } catch (err) { 
                    const msg = err.message.includes('503') 
                        ? "Error: Google API Server Overloaded (503). This is normal for preview models. Wait a few seconds and try again."
                        : "Error: " + err.message;
                    setAiChat(prev => [...prev, { role: 'ai', text: msg }]); 
                } finally { setIsAILoading(false); }
            };

            const startDrag = (e) => {
                e.preventDefault();
