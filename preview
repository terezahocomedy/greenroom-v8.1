        <div className="space-y-4">
          {personas.map(p => (
            <div key={p.id} className="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col gap-2">
              <div className="flex justify-between">
                <input className="bg-transparent font-bold text-purple-400 outline-none" value={p.name} onChange={e=>setPersonas(personas.map(x=>x.id===p.id?{...x, name:e.target.value}:x))} />
                <button onClick={()=>setPersonas(personas.filter(x=>x.id!==p.id))} className="text-red-400 text-xs"><Trash2 size={14}/></button>
              </div>
              <textarea className="bg-transparent text-sm text-slate-300 outline-none resize-none h-20" value={p.prompt} onChange={e=>setPersonas(personas.map(x=>x.id===p.id?{...x, prompt:e.target.value}:x))} />
            </div>
          ))}
        </div>
      </div>
    </div>
  );

  return (
    <div className="flex flex-col h-screen overflow-hidden bg-slate-950 text-slate-200 font-sans">
      {/* Header */}
      <header className="flex items-center justify-between p-4 bg-slate-900/80 border-b border-slate-800 z-10 shrink-0">
        <div className="flex items-center gap-3">
          <div className="bg-orange-600 p-1.5 rounded-lg"><Mic2 size={18} className="text-white"/></div>
          <h1 className="font-black tracking-tight text-lg hidden md:block">GreenRoom <span className="text-[10px] text-orange-400 font-mono border border-orange-500/30 px-1 rounded">v8.2</span></h1>
        </div>
        
        {/* Desktop Nav */}
        <div className="hidden md:flex bg-slate-950 p-1 rounded-xl border border-slate-800">
          {['workspace', 'sets', 'dashboard', 'settings'].map(t => (
            <button key={t} onClick={()=>setView(t)} className={`px-4 py-1.5 rounded-lg text-sm font-bold capitalize transition-colors ${view===t?'bg-slate-800 text-white':'text-slate-500 hover:text-slate-300'}`}>{t}</button>
          ))}
        </div>
        
        <div className="md:hidden font-black text-white capitalize">{view}</div>
      </header>

      {/* Main Content Area */}
      <main className="flex-1 flex overflow-hidden relative">
        {view === 'workspace' && renderWorkspace()}
        {view === 'sets' && renderSetBuilder()}
        {view === 'dashboard' && renderDashboard()}
        {view === 'settings' && renderSettings()}
      </main>

      {/* Mobile Bottom Nav */}
      <nav className="md:hidden bg-slate-900 border-t border-slate-800 flex justify-around p-3 shrink-0 pb-safe">
        {[{id:'workspace', icon:LayoutList}, {id:'sets', icon:LayoutDashboard}, {id:'dashboard', icon:Activity}, {id:'settings', icon:Settings}].map(t => (
          <button key={t.id} onClick={()=>setView(t.id)} className={`flex flex-col items-center gap-1 ${view===t.id?'text-orange-500':'text-slate-500'}`}>
            <t.icon size={20}/>
            <span className="text-[9px] font-bold uppercase">{t.id}</span>
          </button>
        ))}
      </nav>

      {/* Modals */}
      {editingBit && <EditorModal bit={editingBit} onClose={()=>setEditingBit(null)} />}
      
      {/* Stage Mode Modal */}
      {stageMode && (
        <div className="fixed inset-0 bg-black z-[100] flex flex-col p-6 overflow-hidden">
           <div className="flex justify-between items-center mb-8 shrink-0">
             <button onClick={()=>setStageMode(false)} className="text-slate-500 hover:text-white"><X size={24}/></button>
             <h2 className="text-red-500 text-5xl font-black font-mono">STAGE</h2>
           </div>
           <div className="flex-1 overflow-y-auto space-y-6">
             {activeSet.bitIds.map((id, i) => {
               const b = bits.find(x=>x.id===id); if(!b) return null;
               return (
                 <div key={id} className="border-l-4 border-slate-800 pl-4 py-2">
                   <h3 className="text-2xl font-bold text-slate-300">{i+1}. {b.title}</h3>
                   <p className="text-sm text-green-500 font-mono mt-1">{b.duration}m</p>
                 </div>
               )
             })}
           </div>
        </div>
      )}

      {/* Log Show Modal */}
      {logShowModal && (
        <div className="fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4">
          <div className="bg-slate-900 p-6 rounded-2xl w-full max-w-md border border-slate-700">
            <h2 className="text-xl font-bold text-green-400 mb-4">Log Show</h2>
            <input className="w-full bg-slate-950 border border-slate-800 p-3 rounded-lg mb-4 outline-none text-sm" placeholder="Show Name" id="showName" />
            <select className="w-full bg-slate-950 border border-slate-800 p-3 rounded-lg mb-4 outline-none text-sm" id="showLang">
               <option value="English">English</option><option value="廣東話">廣東話</option>
            </select>
            <div className="flex gap-4 mt-4">
              <button onClick={()=>{
                const n = document.getElementById('showName').value; const l = document.getElementById('showLang').value;
                if(n) { setShows([...shows, {id:Date.now().toString(), name:n, language:l, date:Date.now(), rating:0}]); setLogShowModal(false); playSound('success'); }
              }} className="flex-1 bg-green-600 py-3 rounded-lg font-bold">Save</button>
              <button onClick={()=>setLogShowModal(false)} className="flex-1 bg-slate-800 py-3 rounded-lg font-bold">Cancel</button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
